{

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "JwtSettings": {
    "Secret": "",
    "Issuer": "GestoraWebApi",
    "Audience": "GestoraClient",
    "ExpiryMinutes": 60,
    "MaxSessionHours": 12
  },

  "Prenotazioni": {
    "MaxCopertiPerPrenotazione": 50,
    "MaxCopertiPrenotazioneOnline": 20
  },

  "Utenze": {
    "GiorniUtenzaMaiUsata": 180,
    "MesiInattivita": 24,
    "SettimaneAvviso": 4
  },
  "Privacy": {
    "Versione": "2026-10-26"
  },
  "RegistroAttivita": {
    "MesiConservazione": 24
  },
  "Manutenzione": {
    "Attiva": false
  },

  "LimitiRichieste": {
    "RegistrazioniPerFinestra": 10,
    "RegistrazioneFinestraMinuti": 60,
    "ConfermaEmailPerFinestra": 10,
    "ConfermaEmailFinestraMinuti": 60,
    "DisponibilitaRaffica": 20,
    "DisponibilitaAlMinuto": 30
  },

  "Email": {
    "Host": "",
    "Porta": 587,
    "Utente": "",
    "Password": "",
    "MittenteEmail": "",
    "MittenteNome": "Gestora",
    "UrlFrontend": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "// Nota": "In produzione si scrive solo su console: il filesystem del container e' effimero e la piattaforma di hosting raccoglie lo stdout. Il sink su file e' attivo solo in Development.",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext:l} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedOrigins": [ "http://localhost:5173" ]
}

